	"type": "webtrees-module",
	"license": "GPL-3.0+",
	"keywords": [
		"webtrees",
		"genealogy",
		"webtrees-module"
	],
    "require": {
		"php": ">=7.4",
		"justcarmen/jc-common-code": "^1.0",
